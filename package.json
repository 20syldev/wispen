{
    "name": "wispen",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "predev": "npm run icon",
        "dev": "next dev -H 127.0.0.1 -p 9456",
        "icon": "tsx scripts/icon.ts",
        "sw": "tsc -p src/worker",
        "build": "npm run icon && npm run sw && next build",
        "start": "npx serve out -p 9457",
        "lint": "eslint",
        "check": "tsc --noEmit && tsc -p src/worker --noEmit && eslint . && prettier --check .",
        "format": "prettier --write . && eslint --fix ."
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "idb-keyval": "^6.3.0",
        "jspdf": "^4.2.1",
        "lucide-react": "^1.55.0",
        "next": "16.4.0",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.7.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-import": "^2.32.0",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5"
    },
    "description": "A simple, open-source, frontend-only drawing board: rounded shapes, text boxes, pages, local saves and exports.",
    "license": "BSD-3-Clause"
}
